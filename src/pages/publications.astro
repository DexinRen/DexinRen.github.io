---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import { pubs } from '../data/publications';
const years = [...new Set(pubs.map((p) => p.year))].sort((a, b) => b - a);
---
<Base title="Publications" description="Publications by Dexin Ren.">
  <p class="eyebrow">Publications</p>
  <h1>Publications</h1>
  <p class="lede">Peer-reviewed papers and workshop papers. My name is in bold.</p>
  {years.map((y) => (
    <section class="year">
      <h2 class="yh">{y}</h2>
      {pubs.filter((p) => p.year === y).map((p) => <PubItem pub={p} />)}
    </section>
  ))}
</Base>

<style>
  .year { margin-top: 2.5rem; }
  .yh { font-size: 1rem; font-family: var(--font-sans); font-weight: 600; color: var(--ink-3); letter-spacing: .08em; margin: 0 0 .25rem; padding-bottom: .5rem; border-bottom: 1px solid var(--line-strong); }
</style>
