const synth: Record<string, [number[], number[]]> = {
  //                 NUMOSIM 10s, 30s, 1min, 2min          PoL 5s, 10s, 30s, 1min, 2min
  'rt-hybrid':     [[3.04, 3.43, 4.17, 4.84],            [24.25, 20.20, 12.44, 10.16, 11.25]],
