  'alpha-beta':    [[13.94, 19.76, 19.78, 19.84],        [36.71, 37.24, 37.11, 37.03, 36.96]],
  'causal-hampel': [[18.91, 22.03, 25.54, 33.98],        [36.28, 40.43, 39.84, 41.66, 54.46]],
  'hampel':        [[18.84, 18.59, 18.66, 18.82],        [36.54, 37.46, 36.24, 35.44, 35.05]],
  'savgol':        [[9.68, 12.72, 17.36, 26.40],         [34.75, 36.58, 31.88, 29.53, 33.39]],
  'valhalla':      [[30.34, 29.40, 29.07, 29.18],        [44.81, 42.95, 41.72, 41.10, 40.46]],
};
const synthRaw = [[20.22, 19.92, 19.92, 19.95], [36.77, 37.24, 37.19, 37.21, 37.23]];
const bwAcc: Record<string, (number | null)[]> = {
  //               All, <=30 m, <=15 m, <=10 m, <=5 m
  'rt-hybrid':     [57.05, 54.64, 52.15, 45.40, 42.30],
  'rt-trans':      [55.51, 54.22, 52.13, 47.12, 44.74],
  'rt-cnn':        [55.17, 53.61, 51.28, 45.19, 42.10],
  'residualreg':   [null, null, null, null, null], // not evaluated on BlogWatcher within the study period
  'directreg':     [21.81, 19.00, 17.02, 8.96, 5.78],
  'ddim':          [18.29, 15.54, 13.78, 6.22, 4.29],
  'causal-mlp':    [45.18, 42.83, 40.87, 30.57, 27.77],
  'kalman':        [43.52, 42.20, 41.49, 36.95, 34.84],
  'kalman-rts':    [35.72, 33.55, 32.18, 26.37, 23.57],
  'alpha-beta':    [36.33, 32.11, 29.62, 19.28, 15.32],
  'causal-hampel': [37.90, 37.20, 36.36, 32.47, 30.17],
  'hampel':        [45.46, 44.07, 43.37, 38.77, 36.44],
  'savgol':        [35.43, 31.08, 27.69, 16.06, 10.89],
  'valhalla':      [50.80, 48.90, 48.16, 44.47, 44.24],
};
const bwRaw = [[44.63, 43.45, 42.82, 38.52, 36.42]];
const synthSeries = methods.map((m) => ({ ...m, values: synth[m.key] }));
const bwSeries = methods.map((m) => ({ ...m, values: [bwAcc[m.key]], note: m.key === 'residualreg' ? 'not evaluated' : undefined }));

---
<Base title="RectifiedTraj" description="RectifiedTraj: map-free, causal, lightweight GPS trajectory denoising with rectified flow (ACM SIGSPATIAL 2026).">
  <ProjectHeader
    title="RectifiedTraj"
    subtitle="Map-free, causal GPS trajectory denoising that runs on a phone."
    status="Short paper, ACM SIGSPATIAL 2026 main conference · Extended study: full paper, UMFM workshop at SIGSPATIAL 2026, Best UMFM Workshop Paper Award"
    role="First-author lead, USC InfoLab"
    period="Aug 2025 – Sep 2026"
    team="With Shang-Ling Hsu, Chen Chu, Lifeng Lin, Ryosuke Shibasaki, Noboru Koshizuka and Cyrus Shahabi"
    tags={['Distribution shift', 'Rectified flow', 'Failure analysis', 'On-device ML']}
    links={[
      { label: 'Paper (preprint)', href: 'https://drive.google.com/file/d/1an4LTKb96VXZn7xlh_8YtIfjap4P86ue/view?usp=drivesdk', icon: 'file' },
      { label: 'Extended study (preprint)', href: '/media/rectifiedtraj/rectifiedtraj_revisited_preprint.pdf', icon: 'file' },
      { label: 'Extended-study slides', href: '/media/rectifiedtraj/rectifiedtraj_revisited_slides.pdf', icon: 'download' },
      { label: 'Award (extended study)', href: '/media/rectifiedtraj/umfm_best_workshop_paper_award.pdf', icon: 'award' },
      { label: 'Poster', href: '/media/rectifiedtraj/rectifiedtraj_poster.pdf', icon: 'download' },
      { label: 'Code', href: 'https://github.com/DexinRen/RectifiedTraj', icon: 'code' },
    ]}
    tldr={[
      'A <strong>causal, map-free, ~1M-parameter</strong> GPS denoiser: each point is corrected from current and past observations only, with no map or network service.',
      'Models that predict clean coordinates <strong>blow up</strong> when a trajectory window spans more distance (up to 3.6 km mean error). Predicting the <strong>correction field</strong> stays at about 5 m or less.',
      'On real-world BlogWatcher data: <strong>44.6% → 57.1%</strong> of points inside their reference radius. Inference takes <strong>124 ms per 256-point chunk</strong> on a 2020 Pixel 4a, CPU only.',
    ]}
  />

  <h2>Why this problem</h2>
  <p>
    GPS from phones, cars and drones is noisy: reflections, weak reception and urban canyons. Many fixes assume
    things a device often lacks, such as a fresh road map, a network connection, future observations or a GPU.
    I started from those deployment constraints rather than from a model. The denoiser had to be
    <strong>causal</strong> (it cannot see the future), <strong>map-free</strong> (no road network or cloud service),
    and <strong>lightweight</strong> (fast on old phone CPUs).
  </p>

  <h2>How it works</h2>

  <h3>One-step correction with rectified flow</h3>
  <p>
    Rather than predicting clean coordinates, the model predicts a <em>correction</em> for every point: the velocity field that carries the
    noisy trajectory straight to the clean one. Rectified flow makes that path straight, so a single forward pass applies the whole
    correction, where diffusion needs hundreds of steps.
  </p>

  <h3>A causal Hybrid network</h3>
  <div class="grid-2 approach">
    <div>
      <p>
        Denoising a single GPS point on its own is nearly impossible: a fix that is 15 m off looks exactly like a real 15 m step. What
        separates noise from movement is history. Real motion is smooth and consistent: a car keeps its heading and speed, a pedestrian
        turns at a corner. Noise jumps around without that structure.
      </p>
      <p>
        The network therefore reads each point together with the points before it, at two scales. A causal 1-D CNN looks at short stretches
        of the recent past and picks up local motion: speed, heading, turns. A causal Transformer then attends over the whole preceding window
        for longer-range context. Neither ever sees a future point, so the model can run on a live stream. CNN-only and Transformer-only
        versions of the same network double as an ablation of which kind of context matters.
      </p>
    </div>
    <figure class="arch">
      <Fragment set:html={archSvg} />
      <figcaption>Causal Hybrid architecture, as in both papers. <em>τ</em> indicates the noise level of the input <em>X<sub>τ</sub></em>.</figcaption>
    </figure>
  </div>

  <h3>Streaming in overlapping windows</h3>
  <p>
    A phone receives GPS points one after another, so the model works on fixed 256-point windows that slide along the stream. A causal model
    knows least at the start of each window, where it has seen the fewest earlier points. Consecutive windows therefore overlap by a
    <em>head buckle</em> (HB) of <em>Q</em> points: those points are already cleaned and serve only as context, their new predictions are
    dropped, and the rest of the window, the payload, is stitched onto the clean trajectory.
  </p>
  <figure class="hb-anim">
    <!-- one animation per theme; CSS shows the one that matches the site's light / dark theme -->
    <picture class="theme-light">
      <source srcset="/media/rectifiedtraj/reassembly_light_static.svg" media="(prefers-reduced-motion: reduce)" />
      <img src="/media/rectifiedtraj/reassembly_light.gif" width="760" height="300" loading="lazy" alt="Animation: a window made of a head buckle (HB) and a payload sits over the noisy GPS stream, which scrolls past it. The HB covers points that are already cleaned and serves only as context. Each window is denoised in one model step, its HB predictions are dropped, and its payload is stitched onto the clean trajectory." />
    </picture>
    <picture class="theme-dark">
      <source srcset="/media/rectifiedtraj/reassembly_dark_static.svg" media="(prefers-reduced-motion: reduce)" />
      <img src="/media/rectifiedtraj/reassembly_dark.gif" width="760" height="300" loading="lazy" alt="Animation: a window made of a head buckle (HB) and a payload sits over the noisy GPS stream, which scrolls past it. The HB covers points that are already cleaned and serves only as context. Each window is denoised in one model step, its HB predictions are dropped, and its payload is stitched onto the clean trajectory." />
    </picture>
    <figcaption>Head-buckle reassembly on a stream. Each window overlaps the previous one by its head buckle (HB), whose points are already cleaned and serve only as context. The window is denoised in one step, its HB predictions are dropped, and its payload is stitched onto the clean trajectory; the stream then advances by one payload.</figcaption>
  </figure>

  <h2>Results</h2>
  <p>
    Every model is trained only on NUMOSIM-Kanto at its native 10 s sampling interval. Longer NUMOSIM intervals test few-shot transfer,
    Patterns of Life tests zero-shot transfer to a different simulator and noise type, and BlogWatcher tests zero-shot transfer to real phones.
    The extended study compares fourteen methods, from classical filters and map matching to regression baselines and diffusion.
  </p>

  <h3>What the denoised trajectories look like</h3>
  <p>
    All methods see the same noisy trajectories from central Tokyo. Ground truth stays on the left; drag the slider to change the method on the
    right. Methods are ordered from lowest to highest error, and line width encodes each trajectory's error, so the street map gets
    progressively smeared as you slide right.
  </p>
  <TrajGallery
    items={[
      { key: 'raw', label: 'Raw GPS', mean10: 20.22, online10: 20.22, mean2m: 19.95, causal: false },
      { key: 'residualreg-hybrid', label: 'ResidualReg-Hybrid', mean10: 3.01, online10: 2.07, mean2m: 5.02, causal: true },
      { key: 'rt-hybrid', label: 'RT-Hybrid', mean10: 3.04, online10: 2.12, mean2m: 4.84, causal: true },
      { key: 'rt-trans', label: 'RT-Trans.', mean10: 3.26, online10: 2.55, mean2m: 6.08, causal: true },
      { key: 'rt-cnn', label: 'RT-CNN', mean10: 4.49, online10: 4.50, mean2m: 7.35, causal: true },
      { key: 'causal-mlp', label: 'Causal MLP', mean10: 5.42, online10: 5.42, mean2m: 12.35, causal: true },
      { key: 'directreg-hybrid', label: 'DirectReg-Hybrid', mean10: 6.61, online10: 19.63, mean2m: 393.15, causal: true },
      { key: 'kalman-rts', label: 'Kalman-RTS', mean10: 9.02, online10: null, mean2m: 20.20, causal: false },
      { key: 'savgol', label: 'Savitzky–Golay', mean10: 9.68, online10: null, mean2m: 26.40, causal: false },
      { key: 'alpha-beta', label: 'Alpha-Beta', mean10: 13.94, online10: 13.94, mean2m: 19.84, causal: true },
      { key: 'kalman-filter', label: 'Kalman filter', mean10: 14.99, online10: 14.99, mean2m: 19.95, causal: true },
      { key: 'ddim-hybrid', label: 'DDIM-Hybrid', mean10: 18.15, online10: null, mean2m: 3566.32, causal: true },
      { key: 'hampel', label: 'Hampel', mean10: 18.84, online10: null, mean2m: 18.82, causal: false },
      { key: 'causal-hampel', label: 'Causal Hampel', mean10: 18.91, online10: 18.91, mean2m: 33.98, causal: true },
      { key: 'valhalla-meili', label: 'Valhalla Meili', mean10: 30.34, online10: null, mean2m: 29.18, causal: false },
      { key: 'ground-truth', label: 'Ground truth', mean10: null, online10: null, mean2m: null, causal: false },
    ]}
    caption="NUMOSIM-Kanto city-centre subset near the Imperial Palace, Tokyo, from the extended study's qualitative figure. Slider stops are ordered from lowest to highest mean error at the native 10 s interval (full test set). Each trajectory's line width encodes its average error, so thinner is better."
  />

  <h3>Synthetic benchmarks: NUMOSIM and Patterns of Life</h3>
  <p>
    RectifiedTraj and the residual-regression baseline stay low at every interval on both datasets. DirectReg and DDIM spike on NUMOSIM as the
    interval grows but not on Patterns of Life; <a href="#window-span">the next section</a> explains why.
  </p>
  <BenchChart
    id="bench-synth"
    title="Synthetic benchmark: mean error vs. sampling interval"
    subtitle="NUMOSIM-Kanto (left) and Patterns of Life (right). Log scale, lower is better."
    panels={[
      { title: 'NUMOSIM-Kanto', xs: ['10 s', '30 s', '1 min', '2 min'], trainedAt: 0, regimes: [{ from: 1, to: 3, label: 'few-shot', kind: 'few' }] },
      { title: 'Patterns of Life', xs: ['5 s', '10 s', '30 s', '1 min', '2 min'], regimes: [{ from: 0, to: 4, label: 'zero-shot: unseen simulator & noise', kind: 'zero' }] },
    ]}
    raw={synthRaw}
    series={synthSeries}
    scale="log" domain={[2, 5000]} ticks={[3, 10, 30, 100, 300, 1000, 3000]}
    yLabel="mean pointwise error (m, log)" xLabel="sampling interval" unit=" m" better="lower"
    caption={`Predicting clean coordinates (DirectReg) or reconstructing the clean state (DDIM) explodes on NUMOSIM as the p95 within-chunk distance grows from ${p95.join(' → ')} km, but not on Patterns of Life, whose chunks stay short. Predicting the correction (RT, ResidualReg) stays low on both.`}
    source="RectifiedTraj Revisited, Tables 2 and 3 (Mean columns)."
  />

  <h3>Real-world benchmark: BlogWatcher</h3>
  <p>
    BlogWatcher is a non-public, real mobile dataset with a reference radius instead of exact ground truth. A point counts as accurate if it
    falls inside its radius. Raw GPS already scores 44.63%, so any method below the raw line makes the data <em>worse</em>. Several classical filters do.
  </p>
  <BenchChart
    id="bench-blog"
    title="Real-world benchmark: BlogWatcher accuracy"
    subtitle="Share of points inside the provider's reference radius. Higher is better."
    panels={[
      { title: 'BlogWatcher', xs: ['All', '≤ 30 m', '≤ 15 m', '≤ 10 m', '≤ 5 m'], regimes: [{ from: 0, to: 4, label: 'zero-shot: real-world data, never trained on', kind: 'zero' }] },
    ]}
    raw={bwRaw}
    series={bwSeries}
    scale="linear" domain={[0, 62]} ticks={[0, 10, 20, 30, 40, 50, 60]}
    yLabel="accuracy (%)" xLabel="subset by provider reference radius" unit="%" better="higher"
    caption="All three RectifiedTraj variants stay above raw GPS on every subset. Map matching (Valhalla Meili) is the strongest baseline, and on the strictest ≤ 5 m subset it edges past RT-Hybrid and RT-CNN (RT-Trans. stays ahead), but it needs a road map; diffusion and direct regression fall far below raw on these long, irregular sampling intervals (mean 116 s). ResidualReg-Hybrid could not be evaluated on BlogWatcher within the study period."
    source="RectifiedTraj Revisited, Table 4."
  />

  <h3>The start of each window</h3>
  <p>
    I expected a causal model to make more errors where a window starts, because it has seen the fewest earlier points there. The point-wise
    error confirmed this for the Transformer-based variants; the CNN-only variant, with its bounded receptive field, does not show the
    effect. A longer head buckle drops more of those predictions, which trades throughput for accuracy. Move the bar to see both effects at once:
  </p>
  <BuckleDemo />
  <p class="small muted">
    Q = 192 cuts mean error from 3.04 m to 2.16 m and p95 error from 8.83 m to 4.56 m, while still keeping about 9.8k predictions/s.
    Last-point error stays at about 2.1 m throughout, so the gain comes from dropping the poorly contextualised start, not from changing the tail.
  </p>
  <h3>Fast enough on a 2020 budget phone, CPU only</h3>
  <p>
    I tested deployment on a Google Pixel 4a, a budget phone released in 2020 (Snapdragon 730G), using only its CPU: no GPU, no
    accelerator, no network. Even the largest variant, RT-Hybrid, denoises a 256-point chunk in 124 ms, far below the shortest
    sampling interval in the study (5 s), so the denoiser keeps up with the GPS stream with plenty of room to spare.
  </p>
  <div class="stats">
    <div class="stat"><div class="num">124 ms</div><div class="lbl">RT-Hybrid per 256-point chunk, Pixel 4a, CPU only</div></div>
    <div class="stat"><div class="num">11 ms</div><div class="lbl">RT-CNN per chunk (23k points/s)</div></div>
    <div class="stat"><div class="num">≈1M</div><div class="lbl">parameters (5.1 MB exported model)</div></div>
    <div class="stat"><div class="num">1 step</div><div class="lbl">vs. 500 steps for the DDIM baseline</div></div>
  </div>

  <h2 id="window-span">The finding I care most about</h2>
  <p>
    The synthetic benchmark turned up something odd. DirectReg and DDIM produced <em>huge error spikes</em> on NUMOSIM once the data were
    downsampled, yet stayed stable on Patterns of Life, a dataset they had never seen, with a different simulator and noise type.
    ResidualReg and RectifiedTraj stayed stable on both. All four share the same Hybrid backbone, so the architecture is not the explanation.
  </p>
  <p>
    The cause is the <strong>span of the input window</strong>. NUMOSIM agents are always moving, so downsampling makes the distance from
    the first point of a 256-point window to its farthest point grow sharply: the p95 span goes from <strong>{p95[0]} km at 10 s to
    {p95[3]} km at 2 min</strong>. Any model that reconstructs the clean coordinates, directly (DirectReg) or indirectly through a denoising
    process (DDIM), must then output positions far outside the range it was trained on, which is a large out-of-distribution error. A
    correction-field model predicts only the <em>direction and magnitude</em> of each point's error (its velocity or correction field), so
    the absolute position drops out of the objective, and the GPS error itself stays near 20 m at every interval.
  </p>
  <p>
    Patterns of Life simulates how people actually behave: they arrive at a place, stay there for a while, and their GPS points stay in a
    small area. Downsampling barely changes the window span there (its p95 never exceeds 3.76 km), which is why DirectReg and DDIM stay
    stable on it. Try both objectives and both datasets below.
  </p>

  <SpanDemo />

  <div class="callout">
    <strong>An honest result:</strong> a same-backbone <em>residual-regression</em> baseline performs about as well as RectifiedTraj. Most of the
    stability comes from <em>predicting the correction</em>, not from rectified-flow training as such. I reported this in the extended study
    because it changes what the method's real contribution is.
  </div>

  <h2>Other things the experiments taught me</h2>
  <ul>
    <li><strong>Bigger was not better for transfer.</strong> Larger models fit the training set slightly better, but smaller ones often did better across datasets and noise types. Reported models are about 1M parameters, a realistic on-device size.</li>
    <li><strong>Causal sometimes beat non-causal.</strong> Closely matched causal variants (left-padded CNN, causal attention, otherwise identical) were sometimes <em>more</em> accurate than their non-causal counterparts. I still want to understand why.</li>
    <li><strong>Design the experiment around the claim.</strong> My first grid crossed model sizes, objectives, datasets and six sampling intervals. Most of it did not test a claim. The final protocol keeps the intervals that probe zero-shot transfer, few-shot transfer and cross-dataset alignment.</li>
  </ul>

  <h2>Slides &amp; poster</h2>
  <figure class="deck" data-deck data-n="11">
    <div class="deck-stage">
      <img src="/media/rectifiedtraj/slides/01.webp" alt="Slide 1 of 11" width="1280" height="720" />
    </div>
    <div class="deck-bar">
      <span class="deck-ctl">
        <button type="button" class="deck-nav prev" aria-label="Previous slide" disabled>‹</button>
        <span class="deck-count" aria-live="polite">1 / 11</span>
        <button type="button" class="deck-nav next" aria-label="Next slide">›</button>
      </span>
      <a href="/media/rectifiedtraj/rectifiedtraj_revisited_slides.pdf">Open the PDF</a>
    </div>
    <figcaption>
      Talk slides for <em>RectifiedTraj Revisited</em> at the UMFM workshop, ACM SIGSPATIAL 2026, which received the
      <a href="/media/rectifiedtraj/umfm_best_workshop_paper_award.pdf">Best UMFM Workshop Paper Award</a>. Use the arrows, arrow keys or swipe.
    </figcaption>
  </figure>

  <div class="grid-2 media">
    <figure>
      <a href="/media/rectifiedtraj/rectifiedtraj_poster.pdf" class="poster-link">
        <img src="/media/rectifiedtraj/poster_preview.webp" alt="RectifiedTraj conference poster" loading="lazy" />
      </a>
      <figcaption>Conference poster (R-133). Click for the PDF.</figcaption>
    </figure>
    <figure class="presenting">
      <img src="/media/rectifiedtraj/sigspatial2026_presenting.webp" alt="Dexin Ren standing next to the RectifiedTraj poster at ACM SIGSPATIAL 2026" width="900" height="1200" loading="lazy" />
      <figcaption>Presenting the poster at ACM SIGSPATIAL 2026 in Riverside, California.</figcaption>
    </figure>
  </div>

  <script>
    document.querySelectorAll<HTMLElement>('[data-deck]').forEach((deck) => {
      const n = Number(deck.dataset.n);
      const img = deck.querySelector('img')!;
      const prev = deck.querySelector<HTMLButtonElement>('.prev')!;
      const next = deck.querySelector<HTMLButtonElement>('.next')!;
      const count = deck.querySelector('.deck-count')!;
      const src = (k: number) => `/media/rectifiedtraj/slides/${String(k).padStart(2, '0')}.webp`;
      let k = 1;
      const go = (to: number) => {
        k = Math.max(1, Math.min(n, to));
        img.src = src(k);
        img.alt = `Slide ${k} of ${n}`;
        count.textContent = `${k} / ${n}`;
        prev.disabled = k === 1;
        next.disabled = k === n;
        if (k < n) new Image().src = src(k + 1); // preload the next slide
      };
      prev.addEventListener('click', () => go(k - 1));
      next.addEventListener('click', () => go(k + 1));
      deck.tabIndex = 0;
      deck.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { go(k + 1); e.preventDefault(); }
        if (e.key === 'ArrowLeft') { go(k - 1); e.preventDefault(); }
      });
      let x0 = 0;
      deck.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
      deck.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 40) go(k + (dx < 0 ? 1 : -1));
      });
      deck.addEventListener('mouseenter', () => { if (k < n) new Image().src = src(k + 1); }, { once: true });
    });
  </script>

  <h2>Open questions</h2>
  <ul>
    <li>Why do matched causal models sometimes outperform non-causal ones?</li>
    <li>Can a smaller model with a better inductive bias match RT-Hybrid, and can we explain <em>what</em> the correction field has learned?</li>
    <li>Real-world evaluation is limited by data: BlogWatcher is sparse and extreme. A more typical real-world benchmark with exact ground truth would change what we can claim.</li>
  </ul>
</Base>

