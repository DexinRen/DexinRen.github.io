// All numbers below are from the published tables in "RectifiedTraj Revisited" (UMFM @ SIGSPATIAL 2026).
const p95 = [2.36, 6.87, 16.34, 24.35];


// ---- full benchmark (Tables 2-4 of RectifiedTraj Revisited; Mean columns for NUMOSIM and PoL)
// Order matters: it sets each method's marker shape in BenchChart.
const methods = [
  { key: 'rt-hybrid', label: 'RT-Hybrid', rt: true },
  { key: 'rt-trans', label: 'RT-Trans.', rt: true },
  { key: 'rt-cnn', label: 'RT-CNN', rt: true },
  { key: 'residualreg', label: 'ResidualReg-Hybrid' },
  { key: 'directreg', label: 'DirectReg-Hybrid' },
