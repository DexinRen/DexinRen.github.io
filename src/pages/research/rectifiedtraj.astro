  { key: 'alpha-beta', label: 'Alpha-Beta' },
  { key: 'causal-hampel', label: 'Causal Hampel' },
  { key: 'hampel', label: 'Hampel' },
  { key: 'savgol', label: 'Savitzky–Golay' },
  { key: 'valhalla', label: 'Valhalla Meili' },
