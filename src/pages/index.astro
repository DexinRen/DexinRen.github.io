---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import Icon from '../components/Icon.astro';
import Portrait from '../components/Portrait.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import { site } from '../data/site';
import { pubs } from '../data/publications';
import { news } from '../data/news';
import { projects } from '../data/projects';

const selected = pubs.filter((p) => p.selected);
const featured = projects.filter((p) => p.featured).sort((a, b) => a.featured! - b.featured!);

// Structured data so search engines can connect the name "Dexin Ren" to this page.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: 'https://dexinren.github.io/',
  image: 'https://dexinren.github.io/media/portrait.webp',
  jobTitle: 'Research Assistant',
  affiliation: { '@type': 'Organization', name: 'USC InfoLab, University of Southern California', url: 'https://infolab.usc.edu/' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Southern California' },
    { '@type': 'CollegeOrUniversity', name: 'University of Illinois Urbana-Champaign' },
  ],
  knowsAbout: ['Machine learning', 'Distribution shift', 'GPS trajectory denoising', 'Rectified flow'],
  sameAs: [site.github.href],
};
const steps = ['Unexpected result', 'Question the assumptions', 'Competing hypotheses', 'Controlled comparison', 'Failure mode found', 'Redesign data / objective'];
---
<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />
  <section class="hero">
    <div class="hero-text">
    <p class="eyebrow">{site.role}</p>
    <h1>{site.name}</h1>
    <Portrait src="/media/portrait.webp" alt="Dexin Ren" />
    <p class="lede">
      I study <em>why</em> machine-learning models generalize or fail, focusing on how data distributions,
      learning objectives, representations and inductive biases interact, mostly with geospatial and mobility data and with health data. I am
      most interested in settings where the data are limited, shifted, synthetic or otherwise imperfect.
    </p>
    <p class="who">
      I'm a master's student in Computer Science at USC, supervised by Professor
      <a href="https://viterbi.usc.edu/directory/faculty/Shahabi/Cyrus" target="_blank" rel="noopener">Cyrus Shahabi</a> at
      <a href="https://infolab.usc.edu/" target="_blank" rel="noopener">USC InfoLab</a>. <a href="/about/" class="more">More about me →</a>
    </p>
    <ul class="status-list">
      {site.status.map((t, i) => <li class="status"><span class:list={['dot', { alt: i > 0 }]}></span>{t}</li>)}
    </ul>
    <ul class="links">
      <li><a class="btn" href="/cv/"><Icon name="file" />CV</a></li>
      <li><a class="btn ghost" href={site.emails[0].href}><Icon name="mail" />Email</a></li>
      <li><a class="btn ghost" href={site.github.href} target="_blank" rel="me noopener"><Icon name="github" />GitHub</a></li>
    </ul>
    </div>
  </section>

  <section>
    <div class="sec-head"><h2>Selected projects</h2><a href="/research/">All projects →</a></div>
    <FeaturedProjects items={featured} />
  </section>

  <section>
    <h2>Research interests</h2>
    <ul class="interests">
      <li><strong>Data-centric ML.</strong> Designing representations, objectives and evaluation around how the data were generated.</li>
      <li><strong>Robustness & distribution shift.</strong> Transfer across datasets, sampling rates, geographies and from simulation to the real world.</li>
      <li><strong>Failure analysis.</strong> Controlled comparisons that separate architecture, objective, representation and training dynamics.</li>
      <li><strong>Learning with difficult data.</strong> Small samples with high dimensionality, heterogeneous subjects, and subgroups that behave differently.</li>
    </ul>
    <p class="domains"><strong>Domains:</strong> geospatial and mobility data; health data.</p>

    <figure class="flow" aria-label="My research loop">
      <ol>
        {steps.map((s, i) => <li><span class="n">{i + 1}</span><span class="s">{s}</span></li>)}
      </ol>
      <figcaption>How a project usually unfolds for me.</figcaption>
    </figure>
  </section>

  <section>
    <h2>News</h2>
    <ul class="news">
      {news.map((n) => <li><time>{n.date}</time><span set:html={n.html} /></li>)}
    </ul>
  </section>

  <section>
    <div class="sec-head"><h2>Selected publications</h2><a href="/publications/">All publications →</a></div>
    {selected.map((p) => <PubItem pub={p} compact />)}
  </section>

</Base>

<style>
  /* tablet & desktop: text in the left column, the portrait in the right column, centred on the text block */
  .hero-text { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: clamp(24px, 4vw, 48px); }
  .hero-text > * { grid-column: 1; margin-top: 0; }
  .hero-text > .links { margin-top: .75rem; }
  .hero :global(.portrait) { grid-column: 2; grid-row: 1 / span 5; align-self: center; --portrait: clamp(180px, 22vw, 230px); }
  /* phone: the portrait floats right under the name and the description wraps around it */
  @media (max-width: 639px) {
    .hero-text { display: block; }
    .hero :global(.portrait) { float: right; --portrait: clamp(112px, 34vw, 150px); margin: 4px 0 10px 16px; }
    .hero .status-list, .hero .links { clear: both; }
  }
  .hero h1 { font-size: clamp(2.4rem, 1.8rem + 2.6vw, 3.4rem); margin-bottom: .3em; }
  .hero .lede em { font-family: var(--font-serif); font-size: 1.08em; }
  .hero .who { color: var(--ink-2); margin: 0 0 .4rem; }
  .hero .who .more { white-space: nowrap; }
  .status-list { list-style: none; padding: 0; margin: .6rem 0 .25rem; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .status { display: inline-flex; align-items: center; gap: 10px; font-size: .9rem; color: var(--ink-2); background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 7px 14px; margin: 0; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ctl); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ctl) 22%, transparent); flex: none; }
  .dot.alt { background: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent); }
  .interests { list-style: none; padding: 0; }
  .interests li { padding: .5rem 0 .5rem 1.1rem; position: relative; color: var(--ink-2); }
  .interests li::before { content: ''; position: absolute; left: 0; top: 1.05em; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .interests strong { color: var(--ink); font-weight: 600; }
  .domains { margin: .25rem 0 0; color: var(--ink-2); }
  .domains strong { color: var(--ink); font-weight: 600; }

  .flow { margin: 1.75rem 0 0; }
  .flow ol { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0; counter-reset: s; }
  .flow li { margin: 0; position: relative; padding: 0 8px 0 0; }
  .flow li:not(:last-child)::after { content: ''; position: absolute; top: 13px; left: 30px; right: 4px; height: 1px; background: var(--line-strong); }
  .flow .n { position: relative; z-index: 1; display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--surface); border: 1px solid var(--line-strong); font-size: .75rem; color: var(--ink-2); }
  .flow li:last-child .n { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
  .flow .s { display: block; font-size: .78rem; color: var(--ink-2); margin-top: 8px; line-height: 1.35; }
  @media (max-width: 639px) {
    .flow ol { grid-template-columns: 1fr; gap: 10px; }
    .flow li { display: flex; align-items: center; gap: 12px; }
    .flow li:not(:last-child)::after { top: 26px; left: 13px; right: auto; width: 1px; height: 10px; }
    .flow .s { margin: 0; font-size: .88rem; }
  }

  .news { list-style: none; padding: 0; }
  .news li { display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 12px; padding: .45rem 0; border-bottom: 1px dashed var(--line); color: var(--ink-2); font-size: .95rem; }
  .news time { color: var(--ink-3); font-size: .82rem; padding-top: .15em; font-variant-numeric: tabular-nums; }
  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .sec-head a { font-size: .85rem; white-space: nowrap; }
</style>
