---
// Pipeline diagram for NeurogenesisGNN (inline SVG; follows theme colors).
const steps = [
  { t: 'EEG recordings', s: 'per patient, very uneven length' },
  { t: '60-s clips', s: '≈13k clips · 30 patients' },
  { t: 'NeuroGNN encoder', s: 'frozen · InfoLab model', ext: true },
  { t: 'Clip features', s: '≈6.4k-d EEG + age, disease duration' },
  { t: 'Zero / non-zero gate', s: 'logistic hurdle (optional)' },
  { t: 'PLS → Ridge', s: 'supervised low-rank + ℓ2 shrinkage' },
  { t: 'Percentile calibrator', s: 'clip predictions → one estimate' },
  { t: 'Patient estimate', s: 'neurogenesis level', end: true },
];
---
<figure class="np" aria-label="NeurogenesisGNN pipeline">
  <ol>
    {steps.map((s) => (
      <li class:list={[{ ext: s.ext, end: s.end }]}>
        <span class="t">{s.t}</span>
        <span class="s">{s.s}</span>
      </li>
    ))}
  </ol>
  <figcaption>Pipeline. Everything after the frozen encoder (dashed) is fitted on training folds only.</figcaption>
</figure>

<style>
  .np { margin: 2rem 0; }
  .np ol { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 26px 22px; }
  .np li { position: relative; margin: 0; background: var(--surface); border: 1px solid var(--line-strong); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 3px; min-height: 76px; }
  .np li::after { content: '→'; position: absolute; right: -18px; top: 50%; transform: translateY(-50%); color: var(--ink-3); font-size: .9rem; }
  .np li:nth-child(4n)::after, .np li:last-child::after { content: none; }
  .np li.ext { border-style: dashed; background: transparent; }
  .np li.end { background: var(--accent); border-color: var(--accent); }
  .np li.end .t, .np li.end .s { color: var(--on-accent); }
  .t { font-weight: 600; font-size: .85rem; color: var(--ink); line-height: 1.3; }
  .s { font-size: .74rem; color: var(--ink-3); line-height: 1.35; }
  @media (max-width: 760px) {
    .np ol { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 22px; }
    .np li:nth-child(4n)::after { content: '→'; }
    .np li:nth-child(2n)::after { content: none; }
  }
  @media (max-width: 420px) {
    .np ol { grid-template-columns: 1fr; gap: 18px; }
    .np li::after, .np li:nth-child(4n)::after, .np li:nth-child(2n)::after { content: '↓'; right: auto; left: 50%; top: auto; bottom: -17px; transform: translateX(-50%); }
    .np li:last-child::after { content: none; }
  }
</style>
