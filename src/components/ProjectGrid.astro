---
// Grid of expanding project cards (hover to preview on desktop, tap-then-tap on touch).
// Used by the Research page (all projects) and the Home page (featured projects).
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../data/projects';
interface Props { items: Project[]; compact?: boolean }
// compact: narrower cards (up to 3 per row in the normal text column); cards marked featuredIfRoom
// are only shown when the row actually has room for 3.
const { items, compact = false } = Astro.props;
---
<div class:list={['cards-wrap', { compact }]}>
  <div class="cards" data-cards>
    {items.map((p) => <div class:list={['cell', { 'if-room': compact && p.featuredIfRoom }]}><ProjectCard p={p} /></div>)}
  </div>
</div>

<script>
  const touch = window.matchMedia('(hover: none), (pointer: coarse)');
  const phone = window.matchMedia('(max-width: 639px)');
  document.querySelectorAll<HTMLElement>('[data-cards]').forEach((grid) => {
  const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>('[data-card]'));

  // Equalise collapsed slot height so the grid stays tidy.
  function sizeSlots() {
    if (phone.matches) { grid.style.removeProperty('--slot-h'); return; }
    let h = 0;
    for (const c of cards) {
      const head = c.querySelector('.head') as HTMLElement;
      const cs = getComputedStyle(c);
      h = Math.max(h, head.offsetHeight + parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom) + 2);
    }
    grid.style.setProperty('--slot-h', `${Math.ceil(h)}px`);
  }

  // If an expanded card would run off the bottom of the viewport, lift it.
  function fitInView(c: HTMLElement) {
    if (phone.matches) return;
    c.style.setProperty('--shift', '0px');
    const head = c.querySelector('.head') as HTMLElement;
    const inner = c.querySelector('.more-inner') as HTMLElement;
    const r = c.getBoundingClientRect();
    const expected = r.top + head.offsetHeight + inner.scrollHeight + 60;
    const overflow = expected - (window.innerHeight - 16);
    if (overflow > 0) {
      const maxUp = Math.max(0, r.top - 76);
      c.style.setProperty('--shift', `${-Math.min(overflow, maxUp)}px`);
    }
  }
  function closeAll(except?: HTMLElement) {
    for (const c of cards) if (c !== except) { c.classList.remove('is-open'); c.style.setProperty('--shift', '0px'); }
  }

  for (const c of cards) {
    c.addEventListener('mouseenter', () => { if (!touch.matches) fitInView(c); });
    c.addEventListener('mouseleave', () => { if (!touch.matches) c.style.setProperty('--shift', '0px'); });
    c.addEventListener('focus', () => fitInView(c));
    c.addEventListener('click', (e) => {
      // Touch: first tap previews, second tap opens.
      if (touch.matches && !c.classList.contains('is-open')) {
        e.preventDefault();
        closeAll(c);
        c.classList.add('is-open');
        fitInView(c);
        if (phone.matches) setTimeout(() => c.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 320);
      }
    });
  }
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-card]')) closeAll();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });

  sizeSlots();
  window.addEventListener('resize', sizeSlots);
  document.fonts?.ready.then(sizeSlots);
  });
</script>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 22px;
    margin-top: 2rem;
    padding-bottom: 40px;
  }
  @media (max-width: 639px) { .cards { gap: 14px; } }
  .cell { min-width: 0; }
  .compact { container-type: inline-size; }
  .compact .cards { grid-template-columns: repeat(auto-fill, minmax(min(100%, 228px), 1fr)); gap: 18px; }
  /* 3 × 228px + 2 × 18px = 720px: below that the row holds two cards, so the optional one is hidden */
  .compact .if-room { display: none; }
  @container (min-width: 720px) { .compact .if-room { display: block; } }
</style>
