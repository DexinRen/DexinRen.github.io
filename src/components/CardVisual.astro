---
// Small inline illustrations for project cards (inline so they follow the color theme).
interface Props { name: string }
const { name } = Astro.props;

// neuro: deterministic pseudo-random clip strips per patient
const patients = [14, 6, 22, 9, 17, 4, 12];
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);

// qwen: answer-format (GPQA clean) vs MATH500 accuracy across SFT checkpoints
import { qwenEval } from '../data/qwen-eval';
const qx = (step: number) => 24 + (step / 21000) * 276;
const qy = (v: number) => 168 - (v / 0.45) * 130;
const qpath = (vals: number[]) => vals.map((v, i) => `${i ? 'L' : 'M'}${qx(qwenEval.steps[i]).toFixed(1)},${qy(v).toFixed(1)}`).join(' ');

// haystac: Spearman rank agreement between loss ranking and real Visit-AP ranking (100 epochs)
const losses = [
  { k: 'Asym. focal', v: 0.899 },
  { k: 'SmoothAP', v: 0.460 },
  { k: 'Focal', v: 0.436 },
  { k: 'BCE', v: 0.266 },
  { k: 'Tversky', v: 0.216 },
  { k: 'Soft Dice', v: 0.169 },
];
---
{name === 'neuro' && (
  <svg viewBox="0 0 320 200" class="cv" role="img" aria-label="Many EEG clips per patient collapse into one patient-level estimate">
    {patients.map((n, i) => {
      const y = 22 + i * 24;
      return (
        <g>
          {Array.from({ length: n }).map((_, j) => (
            <rect x={14 + j * 6.2 + rnd() * 1.5} y={y + (rnd() - 0.5) * 6} width="4" height="9" rx="1.5" class="clip" />
          ))}
          <path d={`M ${14 + n * 6.2 + 8} ${y + 4.5} C 190 ${y + 4.5}, 200 100, 238 100`} class="flow" />
        </g>
      );
    })}
    <circle cx="262" cy="100" r="22" class="dot-big" />
    <text x="262" y="104" text-anchor="middle" class="t-strong">1</text>
    <text x="262" y="140" text-anchor="middle" class="t">patient label</text>
    <text x="14" y="194" class="t">≈13k clips · 30 patients</text>
  </svg>
)}

{name === 'haystac' && (
  <svg viewBox="0 0 320 200" class="cv" role="img" aria-label="Spearman agreement between each training loss and real detection ranking; asymmetric focal is highest">
    <text x="14" y="20" class="t">loss ranking vs. real ranking (Spearman ρ)</text>
    {losses.map((l, i) => {
      const y = 34 + i * 25;
      const w = l.v * 190;
      return (
        <g>
          <text x="86" y={y + 12} text-anchor="end" class="t">{l.k}</text>
          <rect x="94" y={y} width={w} height="16" rx="3" class:list={[i === 0 ? 'bar-hi' : 'bar']} />
          <text x={94 + w + 6} y={y + 12} class="t">{l.v.toFixed(2)}</text>
        </g>
      );
    })}
  </svg>
)}

{name === 'dementia' && (
  <svg viewBox="0 0 320 200" class="cv" role="img" aria-label="An edited risk factor passes through a latent model, which adjusts correlated factors before risk is recomputed">
    <g class="t">
      <circle cx="40" cy="50" r="15" class="node-edit" /><text x="40" y="54" text-anchor="middle" class="t-on">BMI</text>
      <circle cx="40" cy="100" r="15" class="node" /><text x="40" y="104" text-anchor="middle">BP</text>
      <circle cx="40" cy="150" r="15" class="node" /><text x="40" y="154" text-anchor="middle">Act.</text>
    </g>
    <path d="M58 50 C 90 50, 100 90, 122 96" class="flow-hi" />
    <path d="M58 100 L 122 100" class="flow dashed" />
    <path d="M58 150 C 90 150, 100 110, 122 104" class="flow dashed" />
    <rect x="124" y="70" width="72" height="60" rx="10" class="box" />
    <text x="160" y="97" text-anchor="middle" class="t-strong">latent</text>
    <text x="160" y="113" text-anchor="middle" class="t">completion</text>
    <path d="M198 96 C 220 90, 230 50, 252 50" class="flow" />
    <path d="M198 100 L 252 100" class="flow" />
    <path d="M198 104 C 220 110, 230 150, 252 150" class="flow" />
    <g class="t">
      <circle cx="270" cy="50" r="15" class="node-edit" /><text x="270" y="54" text-anchor="middle" class="t-on">BMI</text>
      <circle cx="270" cy="100" r="15" class="node-adj" /><text x="270" y="104" text-anchor="middle">BP</text>
      <circle cx="270" cy="150" r="15" class="node-adj" /><text x="270" y="154" text-anchor="middle">Act.</text>
    </g>
    <text x="14" y="194" class="t">edit one factor → correlated factors follow</text>
  </svg>
)}

{name === 'qwen' && (
  <svg viewBox="0 0 320 200" class="cv" role="img" aria-label="Over training, answer-format accuracy on GPQA rises from 0.09 to as high as 0.39 while MATH500 accuracy drifts from 0.25 to about 0.2.">
    <line x1="24" y1="168" x2="300" y2="168" class="axis" />
    {[0.1, 0.2, 0.3, 0.4].map((v) => <line x1="24" x2="300" y1={qy(v)} y2={qy(v)} class="grid" />)}
    <path d={qpath(qwenEval.math500)} class="flow dashed" />
    <path d={qpath(qwenEval.gpqaClean)} class="flow-hi" />
    <circle cx={qx(15000)} cy={qy(0.386)} r="4" class="dot-big" />
    <text x={qx(15000)} y={qy(0.386) - 9} text-anchor="middle" class="t-strong">ckpt 15k</text>
    <text x="28" y="26" class="t-box">\boxed{"{"}x{"}"}</text>
    <text x="14" y="194" class="t">GPQA answer-format accuracy (solid) · MATH500 (dashed)</text>
  </svg>
)}

<style>
  .axis { stroke: var(--line-strong); }
  .grid { stroke: var(--line); stroke-dasharray: 2 3; }
  .t-box { font-family: var(--font-serif); font-size: 15px; fill: var(--accent); font-style: italic; }
  .cv { width: 100%; height: 100%; font-family: var(--font-sans); }
  .t { font-size: 10.5px; fill: var(--ink-3); }
  .t-strong { font-size: 12px; fill: var(--ink); font-weight: 600; }
  .t-on { font-size: 9.5px; fill: var(--on-accent); font-weight: 600; }
  .clip { fill: var(--series-2); opacity: .75; }
  .flow { fill: none; stroke: var(--line-strong); stroke-width: 1.2; }
  .flow.dashed { stroke-dasharray: 3 3; }
  .flow-hi { fill: none; stroke: var(--accent); stroke-width: 1.8; }
  .dot-big { fill: var(--accent); }
  .dot-big + text { fill: var(--on-accent); }
  .bar { fill: var(--series-ref); }
  .bar-hi { fill: var(--accent); }
  .node { fill: var(--surface-2); stroke: var(--line-strong); }
  .node + text, .node-adj + text { font-size: 9.5px; fill: var(--ink-2); }
  .node-edit { fill: var(--accent); }
  .node-adj { fill: var(--accent-soft); stroke: var(--accent); stroke-dasharray: 2 2; }
  .box { fill: var(--surface-2); stroke: var(--line-strong); }
</style>
