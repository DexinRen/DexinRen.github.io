---
import CardVisual from './CardVisual.astro';
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
interface Props { p: Project }
const { p } = Astro.props;
const inline = p.image.startsWith('inline:') ? p.image.slice(7) : null;
const mask = p.image.startsWith('mask:') ? p.image.slice(5) : null; // alpha-mask image painted in the accent colour
const statusClass = p.status === 'Published' || p.status === 'Released' ? 's-pub' : p.status === 'Ongoing' ? 's-on' : 's-early';
---
<div class="slot">
  <a class="card" href={`/research/${p.slug}/`} data-card aria-describedby={`intro-${p.slug}`}>
    <div class="head">
      <span class:list={['chip status', statusClass]}>{p.status}</span>
      <h3 class="title">{p.title}</h3>
      <p class="sub">{p.subtitle}</p>
      <p class="meta">{p.role} · {p.period}</p>
    </div>
    <div class="more">
      <div class="more-inner">
        <div class:list={['visual', p.imageFit === 'cover' ? 'cover' : 'contain']}>
          {inline ? <CardVisual name={inline} />
            : mask ? <span class="mask-vis" role="img" aria-label={p.imageAlt} style={`--img: url(${mask})`}></span>
            : <img src={p.image} alt={p.imageAlt} loading="lazy" decoding="async" />}
        </div>
        <p class="intro" id={`intro-${p.slug}`}>{p.intro}</p>
        <ul class="chips">{p.tags.map((t) => <li class="chip">{t}</li>)}</ul>
        <span class="cta">Read the project <Icon name="arrow" size={15} /></span>
      </div>
    </div>
  </a>
</div>

<style>
  .slot { position: relative; height: var(--slot-h, 212px); }
  .card {
    position: absolute; inset: 0 0 auto 0; min-height: 100%;
    display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 20px 20px 18px; color: var(--ink); text-decoration: none;
    box-shadow: var(--shadow-sm);
    transform-origin: 50% 0%;
    transition: transform .28s cubic-bezier(.2,.7,.2,1), box-shadow .28s, border-color .2s;
    -webkit-tap-highlight-color: transparent;
  }
  .head { display: flex; flex-direction: column; gap: 6px; }
  .title { margin: 6px 0 0; font-size: 1.4rem; }
  .sub { margin: 0; color: var(--ink-2); font-size: .95rem; line-height: 1.45; }
  .meta { margin: 4px 0 0; color: var(--ink-3); font-size: .78rem; }
  .status { align-self: flex-start; }
  .s-pub { color: color-mix(in srgb, var(--series-2) 70%, var(--ink)); background: color-mix(in srgb, var(--series-2) 12%, var(--surface)); border-color: transparent; }
  .s-on { color: var(--accent-ink); background: var(--accent-soft); border-color: transparent; }
  .s-early { color: color-mix(in srgb, var(--series-4) 65%, var(--ink)); background: color-mix(in srgb, var(--series-4) 14%, var(--surface)); border-color: transparent; }

  /* expandable region: 0fr → 1fr for smooth height animation */
  .more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .32s cubic-bezier(.2,.7,.2,1); }
  .more-inner { overflow: hidden; min-height: 0; opacity: 0; transition: opacity .2s; }
  /* preview runs edge to edge across the card */
  .visual { margin: 16px -20px 14px; overflow: hidden; background: var(--bg); aspect-ratio: 16 / 10; border-block: 1px solid var(--line); }
  .mask-vis {
    display: block; width: 100%; height: 100%; background: var(--accent);
    -webkit-mask: var(--img) 46% 42% / 165% no-repeat; mask: var(--img) 46% 42% / 165% no-repeat;
    transition: -webkit-mask-size .6s ease, mask-size .6s ease;
  }
  .card:hover .mask-vis, .card.is-open .mask-vis { -webkit-mask-size: 150%; mask-size: 150%; }
  .visual img { width: 100%; height: 100%; }
  .visual.cover img { object-fit: cover; object-position: center 40%; }
  .visual.contain img { object-fit: contain; padding: 6px; }
  .visual.contain :global(svg) { padding: 8px; }
  .intro { font-size: .9rem; color: var(--ink-2); line-height: 1.55; margin: 0 0 12px; }
  .cta { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; font-size: .85rem; font-weight: 600; color: var(--accent-ink); }

  /* expanded state — floats above neighbours */
  .card.is-open,
  .card:focus-visible {
    z-index: 20; border-color: var(--line-strong); box-shadow: var(--shadow-lg);
    transform: translateY(calc(-6px + var(--shift, 0px))) scale(1.035);
  }
  .card.is-open .more, .card:focus-visible .more { grid-template-rows: 1fr; }
  .card.is-open .more-inner, .card:focus-visible .more-inner { opacity: 1; transition-delay: .06s; }
  .card:focus-visible { outline-offset: 4px; }

  /* desktop pointer: hover opens */
  @media (hover: hover) and (pointer: fine) {
    .card:hover { z-index: 20; border-color: var(--line-strong); box-shadow: var(--shadow-lg); transform: translateY(calc(-6px + var(--shift, 0px))) scale(1.035); }
    .card:hover .more { grid-template-rows: 1fr; }
    .card:hover .more-inner { opacity: 1; transition-delay: .06s; }
  }

  /* phones: expand in the flow instead of floating */
  @media (max-width: 639px) {
    .slot { height: auto; }
    .card { position: relative; inset: auto; }
    .card.is-open, .card:focus-visible { transform: none; }
  }
</style>
